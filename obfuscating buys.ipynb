import time
import random
import itertools # Needed for checking the constructed set

start_time = time.time()

# --- Helper Function (Correct and kept from original) ---
# Checks if a given configuration is obfuscating
def is_obfuscating(buys_set, buys_list):
    """
    Checks if a set of buy timings is obfuscating.

    Args:
        buys_set: A set containing the buy timings for fast lookups.
        buys_list: A list containing the buy timings.

    Returns:
        True if the configuration is obfuscating, False otherwise.
    """
    # Iterate through all combinations of 3 distinct buy times
    for a, b, c in itertools.combinations(buys_list, 3):
        sum_abc = a + b + c
        # Check if the sum is divisible by 3
        if sum_abc % 3 == 0:
            average = sum_abc // 3
            # Check if the average is also a buy time
            if average in buys_set:
                # print(f"Violation: a={a}, b={b}, c={c}, sum={sum_abc}, avg={average} IN set") # Optional: uncomment for debugging
                return False
    return True

# --- Part (a): Finding the Largest Obfuscating Configuration ---
# Implements the iterative construction from the feedback

def construct_obfuscating_set():
    """
    Constructs an obfuscating set using the iterative method
    described in the MindPhair solution feedback.
    Starts with S = {0, 1, 3, 4, 10, 12, 13} for n=14.
    """
    # Base set for n=14 (size 7)
    current_set = {0, 1, 3, 4, 10, 12, 13}
    
    # Apply the construction S_new = S \cup {4*max(S) - s | s in S} iteratively
    # We need 3 iterations to reach size 56 and max element 832
    for _ in range(3):
        if not current_set: # Should not happen with the given base case
            break
        m = max(current_set)
        four_m = 4 * m
        new_elements = {four_m - s for s in current_set}
        current_set.update(new_elements)

    # The resulting set should have max element 832, which is < 900
    final_list = sorted(list(current_set))
    final_set = set(final_list) # Keep set version for is_obfuscating

    # Optional: Verify the constructed set is obfuscating (can be time-consuming)
    print("Verifying the constructed set (size {})...".format(len(final_list)))
    verification_start_time = time.time()
    is_valid = is_obfuscating(final_set, final_list)
    verification_end_time = time.time()
    print(f"Verification took {verification_end_time - verification_start_time:.4f} seconds.")
    
    if is_valid:
        print("Constructed set IS obfuscating.")
        return final_list
    else:
        # This shouldn't happen if the feedback's construction method is correct
        print("Error: Constructed set IS NOT obfuscating according to the check!")
        return [] # Return empty list on failure


# --- Main Execution ---

# Part (a)
constructed_buys_list = construct_obfuscating_set()
if constructed_buys_list:
     # We don't print the whole list as it's long
    print(f"(a) Constructed an obfuscating configuration with {len(constructed_buys_list)} buys using the feedback's method.")
    # Example elements: print(f"    Example elements: {constructed_buys_list[:5]} ... {constructed_buys_list[-5:]}")
else:
    print("(a) Failed to construct a verified obfuscating set.")

# Part (b)
print("(b) Is there a larger configuration? Yes, it is believed that larger obfuscating configurations might exist, as finding the absolute maximum size is a known difficult mathematical problem (related to sets without 3-term arithmetic progressions).")

# Part (c)
# Using Monte Carlo simulation (same logic as before, potentially more samples)
def calculate_obfuscating_probability(num_samples=100000, set_size=10, max_minutes=899):
    """
    Estimates the probability that a random configuration is obfuscating
    using Monte Carlo simulation.
    """
    print(f"\nRunning Monte Carlo simulation for Part (c) with {num_samples} samples...")
    obfuscating_count = 0
    total_minutes_range = range(max_minutes + 1) # 0 to 899

    for i in range(num_samples):
        # Choose 10 distinct random minutes
        buys_list = sorted(random.sample(total_minutes_range, set_size))
        buys_set = set(buys_list) # Use set for faster lookups in is_obfuscating

        if is_obfuscating(buys_set, buys_list):
            obfuscating_count += 1
        
        # Optional: Progress indicator
        # if (i + 1) % (num_samples // 10) == 0:
        #     print(f"  ...completed {(i + 1) / num_samples * 100:.0f}%")

    return obfuscating_count / num_samples

# Run simulation for Part (c)
probability = calculate_obfuscating_probability(num_samples=100000) # Increased samples
print(f"(c) Estimated probability (Monte Carlo) of a random 10-buy configuration being obfuscating: {probability:.10f}")


# --- Total Execution Time ---
end_time = time.time()
execution_time = end_time - start_time
print(f"\nTotal execution time: {execution_time:.4f} seconds")
